s:repeat(3,1fr);gap:26px;align-items:start}\n.faq-group{background:var(--paper);border-radius:var(--radius);padding:28px 26px;box-shadow:0 14px 34px rgba(11,37,69,.08)}\n.faq-group h3{font-size:15px;letter-spacing:.15em;color:var(--deep);text-transform:uppercase;border-left:4px solid var(--amber);padding-left:12px;margin-bottom:18px}\n.faq-group article{padding:14px 0;border-top:1px dashed var(--line)}\n.faq-group article:first-of-type{border-top:none}\n.faq-group h4{font-size:15px;color:var(--deep);font-weight:700}\n.faq-group p{margin-top:6px;font-size:13.5px;color:#4a5a70}\n\n/* ---------- 页脚 ---------- */\nfooter{background:var(--deep);color:rgba(255,255,255,.6);padding:44px 6vw;font-size:13px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px}\nfooter strong{color:var(--amber)}\n\n/* ---------- 响应式 ---------- */\n@media (max-width:960px){.hero-body{grid-template-columns:1fr;gap:40px}\n  .ladder{grid-template-columns:1fr;align-items:stretch}\n  .steps{grid-template-columns:repeat(2,1fr)}\n  .client-grid{grid-template-columns:1fr}\n  .faq-groups{grid-template-columns:1fr}}\n@media (max-width:560px){\n  .steps{grid-template-columns:1fr}\n  section{padding:64px 6vw}\n}\n</style><main>\n\n  \n  <header class=\"hero\">\n    <nav class=\"hero-tags\" aria-label=\"页内导航\">\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#guide\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n    <div class=\"hero-body\">\n      <div class=\"hero-copy\">\n        <p class=\"kicker\">speedtv · 订阅服务</p>\n        <h1>speed<span>tv</span></h1>\n        <p class=\"lede\">三档套餐。月付或年付。流量、设备数、节点池，逐项写清。选一档，按四步完成配置。其余交给线路。</p>\n        <div class=\"actions\">\n          <a class=\"btn btn-solid\" href=\"#plans\">查看套餐</a>\n          <a class=\"btn btn-ghost\" href=\"#guide\">快速上手</a>\n        </div>\n      </div>\n      <aside class=\"hero-panel\" aria-label=\"服务速览\">\n        <h2>速览</h2>\n        <div class=\"panel-row\"><span class=\"k\">入门价格</span><span class=\"v\">¥15<em>/月</em></span></div>\n        <div class=\"panel-row\"><span class=\"k\">月流量区间</span><span class=\"v\">100GB – 1000GB</span></div>\n        <div class=\"panel-row\"><span class=\"k\">同时在线设备</span><span class=\"v\">3 – 20 台</span></div>\n        <div class=\"panel-row\"><span class=\"k\">年付优惠</span><span class=\"v\">约省两个月</span></div>\n        <div class=\"panel-row\"><span class=\"k\">配置耗时</span><span class=\"v\">约 5 分钟</span></div>\n        <p class=\"panel-note\">价格与权益以套餐区为准。下单前请确认设备数量与月度用量。</p>\n      </aside>\n    </div>\n  </header>\n\n  \n  <section class=\"plans\" id=\"plans\">\n    <div class=\"sec-head\">\n      <span class=\"no\">01 · PLANS</span>\n      <h2>三档套餐，逐级递进</h2>\n      <p>流量翻倍，设备增加，节点升级。按年付，价格更低。</p>\n    </div>\n    <div class=\"ladder\">\n      <article class=\"plan\">\n        <span class=\"tier\">Step 1</span>\n        <h3>基础版</h3>\n        <p class=\"price\">¥15<small>/月</small></p>\n        <p class=\"annual\">按年付仅需 ¥150/年</p>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n      <article class=\"plan featured\">\n        <span class=\"badge\">热门选择</span>\n        <span class=\"tier\">Step 2</span>\n        <h3>旗舰版</h3>\n        <p class=\"price\">¥35<small>/月</small></p>\n        <p class=\"annual\">按年付仅需 ¥350/年</p>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </article>\n      <article class=\"plan\">\n        <span class=\"tier\">Step 3</span>\n        <h3>团队版</h3>\n        <p class=\"price\">¥85<small>/月</small></p>\n        <p class=\"annual\">按年付仅需 ¥850/年</p>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </div>\n    <p class=\"ladder-note\">单人轻度使用选基础版。追剧与游戏选旗舰版。多人共享或团队场景选团队版。</p>\n  </section>\n\n  \n  <section class=\"guide\" id=\"guide\">\n    <div class=\"sec-head\">\n      <span class=\"no\">02 · GUIDE</span>\n      <h2>四步完成配置</h2>\n      <p>流程固定。每步只做一件事。</p>\n    </div>\n    <div class=\"steps\">\n      <article class=\"step\">\n        <p class=\"num\">01</p>\n        <h3>注册并选择套餐</h3>\n        <p>创建账号。在套餐页选择档位与付款周期。月付灵活，年付更省。</p>\n      </article>\n      <article class=\"step\">\n        <p class=\"num\">02</p>\n        <h3>获取订阅信息</h3>\n        <p>支付完成后，在用户中心查看订阅链接与节点列表。信息仅本人可见。</p>\n      </article>\n      <article class=\"step\">\n        <p class=\"num\">03</p>\n        <h3>导入客户端</h3>\n        <p>打开对应平台的客户端，添加订阅。客户端会自动拉取节点并定期更新。</p>\n      </article>\n      <article class=\"step\">\n        <p class=\"num\">04</p>\n        <h3>选择节点启用</h3>\n        <p>按延迟排序，选一个低延迟节点。开启系统代理。完成。</p>\n      </article>\n    </div>\n  </section>\n\n  \n  <section class=\"clients\" id=\"clients\">\n    <div class=\"sec-head\">\n      <span class=\"no\">03 · CLIENTS</span>\n      <h2>客户端与平台</h2>\n      <p>主流系统均可配置。具体客户端与下载方式以用户中心公告为准。</p>\n    </div>\n    <div class=\"client-grid\">\n      <article class=\"client-card\">\n        <h3>桌面端</h3>\n        <span class=\"sys\">Windows · macOS</span>\n        <p>在用户中心复制订阅链接，导入兼容的桌面客户端。支持自动更新订阅与按延迟排序。配置一次，长期有效。</p>\n        <a class=\"get\" href=\"#\">下载地址见用户中心</a>\n      </article>\n      <article class=\"client-card\">\n        <h3>移动端</h3>\n        <span class=\"sys\">iOS · Android</span>\n        <p>移动端同样通过订阅链接导入。iOS 需使用兼容的应用，Android 安装客户端后扫码或粘贴订阅即可。</p>\n        <a class=\"get\" href=\"#\">下载地址见用户中心</a>\n      </article>\n    </div>\n  </section>\n\n  \n  <section class=\"faq\" id=\"faq\">\n    <div class=\"sec-head\">\n      <span class=\"no\">04 · FAQ</span>\n      <h2>常见问题</h2>\n      <p>按主题分组。先找类别，再看问题。</p>\n    </div>\n    <div class=\"faq-groups\">\n      <div class=\"faq-group\">\n        <h3>套餐与计费</h3>\n        <article>\n          <h4>月付和年付有什么区别？</h4>\n          <p>权益相同。年付总价更低，例如旗舰版年付 ¥350，比月付累计节省约两个月费用。</p>\n        </article>\n        <article>\n          <h4>流量用完会怎样？</h4>\n          <p>当月流量用尽后服务暂停，次月自动重置。也可联系支持了解当月升级档位的选项。</p>\n        </article>\n        <article>\n          <h4>可以中途更换套餐吗？</h4>\n          <p>可以。在用户中心提交变更，差额与生效时间以页面提示为准。</p>\n        </article>\n      </div>\n      <div class=\"faq-group\">\n        <h3>设备与使用</h3>\n        <article>\n          <h4>设备数如何计算？</h4>\n          <p>按同时在线的设备数量计算。基础版 3 台，旗舰版 5 台，团队版 20 台。超出后最早连接的设备会被断开。</p>\n        </article>\n        <article>\n          <h4>订阅链接可以分享吗？</h4>\n          <p>不可以。订阅链接绑定账号，分享会导致设备数被占用，并可能触发安全限制。</p>\n        </article>\n        <article>\n          <h4>节点多久更新一次？</h4>\n          <p>客户端拉取订阅时自动更新。建议保持客户端的自动更新开启。</p>\n        </article>\n      </div>\n      <div class=\"faq-group\">\n        <h3>故障与支持</h3>\n        <article>\n          <h4>连不上节点怎么办？</h4>\n          <p>先更新订阅，再切换其他节点。仍无法连接时，检查本地网络并重启客户端。</p>\n        </article>\n        <article>\n          <h4>如何联系支持？</h4>\n          <p>在用户中心提交工单。旗舰版享有 7x24 优先工单支持，团队版配备专属客户经理。</p>\n        </article>\n        <article>\n          <h4>工单需要提供什么？</h4>\n          <p>账号、所用客户端、问题节点名称与出现时间。信息越完整，处理越快。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <span><strong>speedtv</strong> · 订阅方案与使用说明</span>\n  <span>价格与权益以本页套餐区为准</span>\n</footer>",
